+// anthropicServerToolCallState is one server_tool_use awaiting its *_tool_result.
+type anthropicServerToolCallState struct {
+	Kind        anthropicInputJSONBufferKind // which server tool
+	ToolID      string
+	ToolName    *string // tool_search / code-execution sub-tool name
+	OutputIndex int
+	Query       *string                // web_search query, from the start input or this block's own deltas
+	URL         *string                // web_fetch url, likewise
+	Input       *string                // verbatim input JSON of this block (tool_search, code execution)
+	Caller      *AnthropicToolCaller   // programmatic-tool-calling caller, if spawned from code execution
+	Result      *AnthropicContentBlock // the paired result block once it arrives
+	ResultIndex int                    // content block index of Result
+}
+
+// startServerToolCall registers a server_tool_use block and buffers its input deltas.
+func (state *AnthropicResponsesStreamState) startServerToolCall(index *int, kind anthropicInputJSONBufferKind, toolID string, name *string, outputIndex int) *anthropicServerToolCallState {
+	state.beginInputJSONBuffer(index, kind)
+	call := &anthropicServerToolCallState{Kind: kind, ToolID: toolID, ToolName: name, OutputIndex: outputIndex}
+	if state.ServerToolCalls == nil {
+		state.ServerToolCalls = make(map[string]*anthropicServerToolCallState)
+	}
+	state.ServerToolCalls[toolID] = call
+	state.trackServerToolBlock(index, toolID)
+	return call
+}
+
+func (state *AnthropicResponsesStreamState) trackServerToolBlock(index *int, toolID string) {
+	if index == nil {
+		return
+	}
+	if state.ServerToolBlockIDs == nil {
+		state.ServerToolBlockIDs = make(map[int]string)
+	}
+	state.ServerToolBlockIDs[*index] = toolID
+}
+
+// serverToolCallForBlock returns the call a content block index belongs to.
+func (state *AnthropicResponsesStreamState) serverToolCallForBlock(index *int) *anthropicServerToolCallState {
+	if index == nil {
+		return nil
+	}
+	toolID, ok := state.ServerToolBlockIDs[*index]
+	if !ok {
+		return nil
+	}
+	return state.ServerToolCalls[toolID]
+}
+
+// attachServerToolResult pairs a result block with the call its tool_use_id
+// names. It returns nil when there is no such pending call of this kind.
+func (state *AnthropicResponsesStreamState) attachServerToolResult(index *int, kind anthropicInputJSONBufferKind, block *AnthropicContentBlock) *anthropicServerToolCallState {
+	if index == nil || block.ToolUseID == nil {
+		return nil
+	}
+	call := state.ServerToolCalls[*block.ToolUseID]
+	if call == nil || call.Kind != kind || call.Result != nil {
+		return nil
+	}
+	call.Result = block
+	call.ResultIndex = *index
+	state.trackServerToolBlock(index, call.ToolID)
+	return call
+}
+
+// takeCompletedServerToolCall returns and forgets the call whose result block
+// ends at this content block index.
+func (state *AnthropicResponsesStreamState) takeCompletedServerToolCall(index *int) *anthropicServerToolCallState {
+	call := state.serverToolCallForBlock(index)
+	if call == nil || call.Result == nil || call.ResultIndex != *index {
+		return nil
+	}
+	delete(state.ServerToolCalls, call.ToolID)
+	delete(state.ServerToolBlockIDs, *index)
+	return call
+}
